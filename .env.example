# =============================================================================
# Food App — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values:
#   cp .env.example .env.local
#
# NEVER commit .env.local, .env, or any file containing real secrets.
# All values below should be treated as sensitive.

# --- Sentry (MCP Server) ---
# Get this from your Sentry account / Expo integration dashboard.
# Used by the .vscode/mcp.json Sentry MCP server for error tracking integration.
SENTRY_MCP_URL=https://mcp.sentry.dev/mcp/mvdev-l7/react-native

# --- App Configuration ---
# These could be used for future backend/API integration.
# For now, all data is static in constants/index.ts.
# BASE_API_URL=https://api.your-backend.com
# API_TIMEOUT_MS=10000

# --- Future: Push Notifications ---
# EXPO_PUSH_TOKEN_SERVER=
# FCM_SERVER_KEY=

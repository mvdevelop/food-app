# .npmrc — Security & Reproducibility Configuration
# ====================================================
# Enforces best practices for dependency management.

# Always save exact versions (no ^ or ~) for production deps
# This ensures reproducible builds across environments
save-exact=true

# Always run npm audit on install
audit=true

# Audit level for `npm audit` — moderate catches more issues than high
# The CI pipeline uses audit-ci for stricter allowlisting control
audit-level=moderate

# Show funding messages (helps track project support)
fund=false

# Ignore root package.json scripts during install (supply chain protection)
# Set to false to allow — but review with `npm audit` regularly
ignore-scripts=false
